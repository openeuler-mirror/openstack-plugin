index 0000000..53da7af
--- /dev/null
+++ b/nova/virt/ironic/dpu_driver.py
@@ -0,0 +1,876 @@
+# Copyright 2023 Huawei Technology corp.
+#
+#    Licensed under the Apache License, Version 2.0 (the "License"); you may
+#    not use this file except in compliance with the License. You may obtain
+#    a copy of the License at
+#
+#         http://www.apache.org/licenses/LICENSE-2.0
+#
+#    Unless required by applicable law or agreed to in writing, software
+#    distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+#    WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+#    License for the specific language governing permissions and limitations
+#    under the License.
+
+"""
+A driver wrapping the Ironic API, such that Nova may provision
+bare metal resources.
+"""
+import json
+import logging as ori_logging
+
+from os_brick import initiator
+from os_brick import exception as os_brick_exception
+from os_brick.initiator import connector
+from oslo_log import log as logging
+from oslo_concurrency import processutils
+from oslo_serialization import jsonutils
+
+from nova.compute import task_states
+import nova.conf
+from nova import exception
+from nova import network
+from nova import context as nova_context
+from nova import objects
+from nova import utils
+from nova.virt.ironic import driver
+from nova.virt.ironic import vif as ironic_vif
+from nova.virt.ironic import spdk_lib
+
+LOG = logging.getLogger(__name__)
+
+# disable processutils log
+ori_logging.getLogger('oslo_concurrency.processutils').\
+    setLevel(ori_logging.CRITICAL)
+
+CONF = nova.conf.CONF
+
+STORAGE_MODE = 'kernel'
+USE_MULTIPATH = True
+
+def _run_cmd_by_root(cmd, log_cmd=True):
+    # 基于rootwrap机制运行，以rootwrap配置文件中配置的权限运行
+    try:
+        root_helper = utils.get_root_helper()
+        if log_cmd:
+            LOG.debug('EXECUTE CMD:%s', ' '.join(cmd))
+        return processutils.execute(*cmd, root_helper=root_helper,
+                                    run_as_root=True)
+    except processutils.ProcessExecutionError as e:
+        raise exception.ProcessExecuteException(
+            cmd=(' '.join(cmd) if log_cmd else ""),
+            reason=(e if log_cmd else e.exit_code)
+        ) from None
+
+class DPUIronicDriver(driver.IronicDriver):
+    # rootwrap中的名字，实际以rootwrap中配置的绝对路径运行。
+    smi_path = 'dpak-smi'
+
+    def __init__(self, virtapi, read_only=False):
+        super(DPUIronicDriver, self).__init__(virtapi)
+        self.vif_driver = ironic_vif.IronicVIFDriver()
+        self.volume_driver = \
+            connector.InitiatorConnector.factory(initiator.ISCSI,
+                                                 utils.get_root_helper(),
+                                                 use_multipath=USE_MULTIPATH)
+        self.initiator_iqn = self.volume_driver.get_initiator()
+        self.network_api = network.API()
+        self.spdk_driver = self._get_volume_driver()
+        self.fs_driver = self._get_fs_driver()
+
+    def _check_dpu_slot_info(self, dpu_slot_info, volume_id):
+        if not dpu_slot_info:
+            LOG.error('volume %s dpu_slot_info not exist', volume_id)
+            return False
+        type = dpu_slot_info.get('type')
+        if type == 'blk':
+            function_id = dpu_slot_info.get('function_id')
+            if not function_id:
+                LOG.error('volume %s function_id not exist', volume_id)
+                return False
+        elif type == 'scsi':
+            dbdf = dpu_slot_info.get('dbdf')
+            scsi_tgt_num = dpu_slot_info.get('scsi_tgt_num')
+            if not dbdf or scsi_tgt_num is None: # scsi_tgt_num可能为0
+                LOG.error(
+                    'volume %s dpu_slot_info error. dbdf %s scsi_tgt_num %s',
+                    volume_id, dbdf, scsi_tgt_num)
+                return False
+        else:
+            LOG.error('unsupport volume type %s', type)
+            return False
+        return True
+
+    def _recover_volume(self, context, instance):
+        LOG.debug('_recover_volume begine', instance=instance)
+
+        @utils.synchronized(instance.uuid)
+        def _do_recover_volume(context, instance):
+            LOG.debug('_do_recover_volume begine', instance=instance)
+
+            bdms = objects.BlockDeviceMappingList.get_by_instance_uuid(
+                context, instance.uuid)
+            need_os_ready = False
+            for bdm in bdms:
+                if bdm.connection_info is None:
+                    LOG.warning('bdm connection_info is none %s', bdm.volume_id,
+                                instance=instance)
+                    continue
+                connection_info = jsonutils.loads(bdm.connection_info)
+                volume_id = connection_info.get('volume_id')
+                LOG.debug('_recover_volume. volume_id %s', volume_id)
+                data = connection_info.get('data')
+                if not data:
+                    LOG.error('volume_id %s data none', volume_id)
+                    continue
+
+                dpu_slot_info = data.get('dpu_slot_info')
+                if not self._check_dpu_slot_info(dpu_slot_info, volume_id):
+                    continue
+
+                if self.spdk_driver.STORAGE_MODE == 'kernel':
+                    disk_paths = self.volume_driver.get_volume_paths(data)
+                    # lvm下获取的是单路径，oc下的待观察
+                    LOG.debug('disk_paths %s', disk_paths)
+                    if len(disk_paths) == 0:
+                        self._connect_volume(data)  # 今年只搞内核态
+                    else:
+                        # 考虑可能是残留引起的。理论上这个就是自动恢复的
+                        LOG.warning('volume %s disk_paths exist', volume_id)
+                        data['device_path'] = disk_paths[0]
+
+                type = dpu_slot_info.get('type')
+                if type == 'blk':
+                    function_id = dpu_slot_info.get('function_id')
+                    bdevs_info = self.spdk_driver.get_bdevs()
+                    bdev_name = volume_id
+                    if bdev_name in bdevs_info:
+                        LOG.warning('volume %s bdev exist', volume_id)
+                        continue # 控制器也不搞了
+
+                    controllers_info = self.spdk_driver.get_controllers()
+                    controllers = self.spdk_driver.parse_controllers_info(
+                        controllers_info)
+                    if function_id in controllers:
+                        LOG.warning(
+                            'volume %s controller exist function_id %s',
+                            volume_id, function_id)
+                        continue
+
+                    # 插入bdev
+                    self.spdk_driver.bdev_create(connection_info)
+                    qos_info = data.get('qos_specs')
+                    if qos_info:
+                        self.spdk_driver.set_bdev_qos(volume_id, qos_info)
+                    # 插入控制器
+                    self.spdk_driver.create_blk_controller(function_id,
+                                                           bdev_name, volume_id)
+                    # os_ready
+                    need_os_ready = True
+                elif type == 'scsi':
+                    dbdf = dpu_slot_info.get('dbdf')
+                    scsi_tgt_num = dpu_slot_info.get('scsi_tgt_num')
+                    bdevs_info = self.spdk_driver.get_bdevs()
+                    bdev_name = volume_id
+                    if bdev_name in bdevs_info:
+                        LOG.warning('volume %s bdev exist', volume_id)
+                        continue  # 控制器也不搞了
+
+                    controllers_info = self.spdk_driver.get_controllers()
+                    controllers = self.spdk_driver.parse_controllers_info(
+                        controllers_info)
+
+                    # 这里不能只看控制器，考虑一次恢复多个盘，控制器可能是存在的。
+                    controller_exist = dbdf in controllers
+                    if controller_exist and scsi_tgt_num in controllers[dbdf]:
+                        LOG.warning('scsi volume %s target exist '
+                                    'dbdf %s scsi_tgt_num %s',
+                                    volume_id, dbdf, scsi_tgt_num)
+                        continue
+
+                    # 插入bdev
+                    self.spdk_driver.bdev_create(connection_info)
+                    qos_info = data.get('qos_specs')
+                    if qos_info:
+                        self.spdk_driver.set_bdev_qos(volume_id, qos_info)
+                    # 插入控制器
+                    if not controller_exist:
+                        self.spdk_driver.create_scsi_controller(dbdf)
+                    self.spdk_driver.add_target(bdev_name, dbdf, scsi_tgt_num)
+                    # os_ready
+                    need_os_ready = True
+                else:
+                    LOG.error('unsupport volume type %s', type)
+
+            if need_os_ready: # 如果永远echo，VF服务器有问题
+                LOG.info('recover volume done echo storage ready')
+                self.spdk_driver.os_ready()
+            _run_cmd_by_root(['sync'])
+            LOG.debug('_do_recover_volume. end', instance=instance)
+
+        return _do_recover_volume(context, instance)
+
+    def _recover_share(self, context, instance):
+        LOG.debug('_recover_share begin', instance=instance)
+
+        @utils.synchronized(instance.uuid)
+        def _do_recover_share(context, instance):
+            LOG.debug('_do_recover_share begin', instance=instance)
+
+            # objects.ShareMappingList.get_by_instance_uuid   拿到所有sm
+            share_mapping_list = objects.ShareMappingList.get_by_instance_uuid(
+                context, instance.uuid)
+            # for sm in smlist:
+            for share_mapping in share_mapping_list:
+                if share_mapping.extra is None:
+                    LOG.warning('share_mapping extra is none %s', share_mapping.extra)
+                    continue
+
+                # 把extra里的pf信息拿出来
+                extra_dict = json.loads(share_mapping.extra)
+                bdf_id = extra_dict.get('bdf_id')
+                target = '/mnt/share-' + share_mapping.uuid
+                LOG.debug('_do_recover_share, bdf_id = %s, target = %s', bdf_id, target)
+
+                # 根据原来的pf挂载
+                try:
+                    self._mount_share(share_mapping.export_location, target)
+                except Exception as exc:
+                    LOG.error('_mount_share error')
+
+                try:
+                    self.fs_driver.create_fs_controller(bdf_id, target, share_mapping.uuid)
+                except Exception as exc:
+                    LOG.error('recover_share spdk error, id = %s', share_mapping.uuid)
+                    self._umount_share(target)
+                    raise exc
+
+            LOG.debug('_do_recover_share. end', instance=instance)
+
+        return _do_recover_share(context, instance)
+
+    def init_host(self, host):
+        """Initialize anything that is necessary for the driver to function.
+
+        :param host: the hostname of the compute host.
+
+        """
+        LOG.debug('init_host.')
+        nodes = self.ironic_connection.nodes()
+        instance_uuid = None
+        for node in nodes:
+            LOG.debug('init host node: {}'.format(node))
+            node_info = self._get_node(node.id)
+            LOG.debug('init host node_info: {}'.format(node_info))
+            LOG.debug('init host node_info extra: {}'.format(node_info.extra))
+            if node_info.extra.get('dpu_host') == CONF.host:
+                instance_uuid = node_info.instance_id
+        LOG.debug('init host instance_uuid: {}'.format(instance_uuid))
+        if not instance_uuid:
+            # 该节点没有绑定instance
+            LOG.info('init_host: no instance')
+            return
+
+        admin_context = nova_context.get_admin_context()
+        try:
+            instance = objects.Instance.get_by_uuid(admin_context, instance_uuid)
+        except exception.InstanceNotFound:
+            LOG.error('init host instance %s not found', instance_uuid)
+            return
+        LOG.debug('vm_state: %s task_state: %s', instance.vm_state,
+                  instance.task_state, instance=instance)
+        resize_states = task_states.resizing_states + (task_states.RESIZE_REVERTING, task_states.RESIZE_CONFIRMING)
+        # 如果在迁移过程中，不恢复
+        if instance.task_state not in resize_states:
+            self._recover_volume(admin_context, instance)
+            self._recover_share(admin_context, instance)
+
+    def _get_storage_type(self):
+        pf_infos = self._get_pfs_info_by_type('storage')
+        if not pf_infos:
+            LOG.error('Can not access to storage pfs')
+            raise exception.PciDeviceRequestFailed(
+                'An exception occurred when got storage pfs.'
+            )
+        # 从第一个pf获取对应的类型
+        storage_type = pf_infos[0]['type']
+
+        return storage_type
+
+    def _get_volume_driver(self):
+        storage_type = self._get_storage_type()
+        if storage_type == 'virtio-blk':
+            return spdk_lib.BLKVolumeDriver(self.initiator_iqn,
+                                            CONF.ironic.iscsi_mode)
+        elif storage_type == 'virtio-scsi':
+            return spdk_lib.SCSIVolumeDriver(self.initiator_iqn,
+                                             CONF.ironic.iscsi_mode)
+        else:
+            raise NotImplementedError('Spdk driver only supports virtio-blk '
+                                      'and virtio-scsi. Type: %s', storage_type)
+
+    def _get_fs_driver(self):
+        return spdk_lib.FSDriver()
+
+    def _get_all_pf_info(self):
+        cmd = [self.smi_path, 'info', '-t', 'dbdf_list']
+        out, err = _run_cmd_by_root(cmd)
+        if err:
+            LOG.error('An exception occurred when got all pf info. '
+                      'err: {}'.format(err))
+            raise exception.PciDeviceRequestFailed(
+                'An exception occurred when got all pfs.'
+            )
+        try:
+            pf_infos = json.loads(out)
+        except Exception as e:
+            LOG.error('Get pf info error: {}'.format(e))
+            return []
+        LOG.debug('pf infos: {}'.format(pf_infos))
+        return pf_infos
+
+    def _get_pfs_info_by_type(self, type):
+        cmd = [self.smi_path, 'info', '-t', 'device_pcie_list', '-f', type]
+        out, err = _run_cmd_by_root(cmd)
+        if err:
+            LOG.error('An exception occurred when got all pf info. '
+                      'err: {}'.format(err))
+            raise exception.PciDeviceRequestFailed(
+                'An exception occurred when got all pfs.'
+            )
+        try:
+            pf_infos = json.loads(out)
+        except Exception as e:
+            LOG.error('Get pf info error: {}'.format(e))
+            return []
+        LOG.debug('pf infos: {}'.format(pf_infos))
+        return pf_infos
+
+    def _get_unused_pf(self, type):
+        pf_infos = self._get_pfs_info_by_type(type)
+        for pf_info in pf_infos:
+            if pf_info['used'] == 0:
+                LOG.info('Get unused pf: {}'.format(pf_info))
+                return pf_info
+        return None
+
+    def _get_unused_vfs_pf(self):
+        vfs_pf_infos = self._get_pfs_info_by_type('storage')
+        LOG.info('get used virtio-fs PF, vfs_pf_infos: {}'.format(vfs_pf_infos))
+        for pf_info in vfs_pf_infos:
+            if pf_info['type'] == 'virtio-fs':
+                if pf_info['used'] == 0:
+                    LOG.info('Get unused pf: {}'.format(pf_info))
+                    return pf_info
+        return None
+
+    def _get_pf_by_mac(self, mac):
+        pf_infos = self._get_pfs_info_by_type('net')
+        for pf_info in pf_infos:
+            if pf_info['mac'] == mac:
+                if pf_info['used'] == 0:
+                    LOG.info('Get pf by mac: {}'.format(pf_info))
+                    return pf_info
+                else:
+                    LOG.warning('Get pf by mac, '
+                                'pf is in use: {}'.format(pf_info))
+                    return None
+        return None
+
+    def attach_interface_dpu(self, context, instance, port_name, port_id,
+                             port_status, vm_uuid, mac_address):
+        LOG.info('attach_interface port_name:%s, port_id:%s, port_status:%s,'
+                 'vm_uuid:%s, mac_address:%s',
+                 port_name, port_id, port_status, vm_uuid, mac_address)
+        self.vif_driver.show()
+        pf_info = self._get_pf_by_mac(mac_address)
+        if pf_info is None:
+            LOG.warning("No pf's mac can match {}".format(mac_address))
+            pf_info = self._get_unused_pf('net')
+            if pf_info is None:
+                LOG.error('Not enough PF devices available for allocation')
+                raise exception.PciDeviceRequestFailed(
+                    'Not enough PF devices available for allocation'
+                )
+        function_id = pf_info['index']
+        port_status = port_status.lower()
+        mac_address = pf_info['mac']
+        self.vif_driver.plug_vif(port_id=port_id, port_name=port_name,
+                                 mac_address=mac_address,
+                                 instance_uuid=instance.uuid,
+                                 port_status=port_status,
+                                 representor=function_id)
+        LOG.info('attach_interface mac_address:%s', mac_address)
+        self.vif_driver.show()
+        _run_cmd_by_root(["sync"])
+        return mac_address
+
+    def detach_interface_dpu(self, context, instance, port_name):
+        LOG.info('detach_interface_dpu port_name:%s', port_name)
+        self.vif_driver.show()
+        self.vif_driver.unplug_vif(port_name, instance.uuid)
+        self.vif_driver.show()
+        _run_cmd_by_root(['sync'])
+
+    def attach_blk_volume(self, context, connection_info, instance, mountpoint,
+                      disk_bus=None, device_type=None, encryption=None):
+        volume_id = connection_info['volume_id']
+        LOG.info('dpu driver attach_volume volume_id {}'.format(volume_id))
+
+        pf_info = self._get_unused_pf('storage')
+        if pf_info is None:
+            # 如果PF资源不够就直接返回异常
+            raise exception.PciDeviceRequestFailed(
+                'Not enough PF devices available for allocation'
+            )
+        function_id = pf_info['index']
+        bdev_name = volume_id
+        data = connection_info['data']
+        self.spdk_driver.bdev_create(connection_info)
+        qos_info = data.get('qos_specs')
+        if qos_info:
+            self.spdk_driver.set_bdev_qos(volume_id, qos_info)
+        self.spdk_driver.create_blk_controller(function_id, bdev_name,
+                                               volume_id)
+        connection_info['data']['dpu_slot_info'] = {
+            'type': 'blk',
+            'function_id': function_id
+        }
+
+    def _get_storage_pfs(self):
+        pf_infos = self._get_pfs_info_by_type('storage')
+        pfs = []
+        for pf_info in pf_infos:
+            pfs.append(pf_info['dbdf'])
+
+        return pfs
+
+    def _get_available_slots(self):
+        # get controllers list
+        controllers_info = self.spdk_driver.get_controllers()
+        controllers = self.spdk_driver.parse_controllers_info(controllers_info)
+
+        available_pfs = self._get_storage_pfs()
+        slots = {}
+        max_slots = self.spdk_driver.MAX_SCSI_SLOTS
+
+        for dbdf, scsi_targets in controllers.items():
+            available_pfs.remove(dbdf)
+            if len(scsi_targets) == max_slots:
+                continue
+
+            scsi_targets_unused = list(range(max_slots))
+
+            for scsi_target_num in scsi_targets.keys():
+                scsi_targets_unused.remove(scsi_target_num)
+
+            slots[dbdf] = scsi_targets_unused
+
+        # sort by available slots number
+        if slots:
+            available_controllers = sorted(slots.items(),
+                                           key=lambda item: len(item[1]),
+                                           reverse=True)
+            # return the available pfs and the most idle controller
+            return available_pfs, available_controllers[0]
+
+        return available_pfs, []
+
+    def _get_slots_to_attach(self):
+        available_pfs, available_slots = self._get_available_slots()
+        slots_to_attach = {}
+
+        if not available_pfs:
+            if not available_slots:
+                # there is no more slots for creating a controller
+                raise exception.PciDeviceRequestFailed(
+                    'Not enough PF devices available for allocation'
+                )
+            # No more pf but some slots still available
+            dbdf = available_slots[0]
+            scsi_tgt_num = available_slots[1][0]
+        else:
+            dbdf = available_pfs[0]
+            scsi_tgt_num = 0
+            self.spdk_driver.create_scsi_controller(dbdf)
+
+        slots_to_attach['dbdf'] = dbdf
+        slots_to_attach['scsi_tgt_num'] = scsi_tgt_num
+
+        return slots_to_attach
+
+    def attach_scsi_volume(self, context, connection_info, instance, mountpoint,
+                      disk_bus=None, device_type=None, encryption=None):
+        volume_id = connection_info['volume_id']
+        bdev_name = volume_id
+        data = connection_info['data']
+
+        self.spdk_driver.bdev_create(connection_info)
+        qos_info = data.get('qos_specs')
+        if qos_info:
+            self.spdk_driver.set_bdev_qos(volume_id, qos_info)
+
+        slots_to_attach = self._get_slots_to_attach()
+        dbdf = slots_to_attach['dbdf']
+        scsi_tgt_num = slots_to_attach['scsi_tgt_num']
+        self.spdk_driver.add_target(bdev_name, dbdf, scsi_tgt_num)
+        connection_info['data']['dpu_slot_info'] = {
+            'type': 'scsi',
+            'dbdf': dbdf,
+            'scsi_tgt_num': scsi_tgt_num,
+        }
+
+    def _update_volume_pci_info(self, context, connection_info, instance):
+        volume_id = connection_info.get('volume_id')
+        LOG.debug('dpu driver _update_volume_pci_info volume_id %s', volume_id)
+
+        dpu_slot_info = connection_info['data'].get('dpu_slot_info')
+        LOG.debug('dpu driver _update_volume_pci_info dpu_slot_info %s',
+                  dpu_slot_info)
+        if not dpu_slot_info:
+            LOG.warning('_update_volume_pci_info failed, no dpu_slot_info')
+            return
+
+        try:
+            bdm = objects.BlockDeviceMapping.get_by_volume_and_instance(
+                context, volume_id, instance.uuid)
+        except exception.NotFound:
+            LOG.warning('_update_volume_pci_info failed, '
+                        'volume %(vol)s is not attached to instance.',
+                        {'vol': volume_id},
+                        instance=instance)
+            return
+
+        if not bdm.connection_info:
+            LOG.warning('update_volume_pci_info failed, no bdm.connection_info')
+            return
+        bdm_connection_info = jsonutils.loads(bdm.connection_info)
+        bdm_connection_info['data']['dpu_slot_info'] = dpu_slot_info
+        bdm.connection_info = jsonutils.dumps(bdm_connection_info)
+        bdm.save()
+
+    def attach_volume(self, context, connection_info, instance, mountpoint,
+                      disk_bus=None, device_type=None, encryption=None):
+        LOG.info('dpu driver attach_volume volume_id %s',
+                 connection_info['volume_id'])
+        connection_info['initiator_iqn'] = self.initiator_iqn
+        data = connection_info['data']
+        # iscsiadm connect to target
+        self._connect_volume(data)   # 今年只搞内核态
+        if not isinstance(self.spdk_driver, spdk_lib.SCSIVolumeDriver):
+            self.attach_blk_volume(context, connection_info, instance,
+                                   mountpoint, disk_bus=None, device_type=None,
+                                   encryption=None)
+        else:
+            self.attach_scsi_volume(context, connection_info, instance,
+                                    mountpoint, disk_bus=None, device_type=None,
+                                    encryption=None)
+        # update pci slot to db
+        self._update_volume_pci_info(context, connection_info, instance)
+
+        # prepare storage
+        storage_ready = connection_info.get('storage_ready')
+        LOG.info('flag storage_ready: {}'.format(storage_ready))
+        if storage_ready:
+            LOG.info('attach_volume done echo storage ready')
+            self.spdk_driver.os_ready()
+        _run_cmd_by_root(['sync'])
+        dpu_slot_info = connection_info['data'].get('dpu_slot_info')
+        LOG.debug('dpu driver attach_volume dpu_slot_info %s', dpu_slot_info)
+        return dpu_slot_info
+
+    def detach_blk_volume(self, context, connection_info, instance, mountpoint,
+                      encryption=None):
+        # 获取function_id
+        volume_id = connection_info['volume_id']
+        LOG.info('dpu driver detach_volume volume_id {}'.format(volume_id))
+        function_id = self._get_function_id_by_bdevname(volume_id)
+        if not function_id:
+            LOG.error('detach_volume PF not found')
+            raise exception.PciDeviceNotFound(
+                node_id=volume_id, address=str(function_id)
+            )
+        # 删除控制器
+        self.spdk_driver.delete_controller(function_id)
+        self.spdk_driver.bdev_delete(volume_id)
+
+    def _is_controller_empty(self, controller_dbdf):
+        controllers_info = self.spdk_driver.get_controllers()
+        controllers = self.spdk_driver.parse_controllers_info(controllers_info)
+        for dbdf, scsi_targets in controllers.items():
+            if dbdf == controller_dbdf:
+                if scsi_targets:
+                    return False
+                else:
+                    return True
+
+        raise exception.PciDeviceNotFound(
+                address=dbdf
+        )
+
+    def _get_scsi_slot_by_bdevname(self, bdev_name):
+        controllers_info = self.spdk_driver.get_controllers()
+        controllers = self.spdk_driver.parse_controllers_info(controllers_info)
+        scsi_tgt_info = {}
+
+        for dbdf, scsi_targets in controllers.items():
+            for scsi_tgt_num, bdev in scsi_targets.items():
+                if bdev == bdev_name:
+                    scsi_tgt_info['scsi_tgt_num'] = scsi_tgt_num
+                    scsi_tgt_info['dbdf'] = dbdf
+                    return scsi_tgt_info
+
+        return None
+
+    def detach_scsi_volume(self, context, connection_info, instance, mountpoint,
+                      encryption=None):
+        volume_id = connection_info['volume_id']
+        bdev_name = volume_id
+        scsi_tgt_info = self._get_scsi_slot_by_bdevname(bdev_name)
+
+        if not scsi_tgt_info:
+            LOG.error('Controller not found')
+            raise exception.PciDeviceNotFound(
+                node_id=instance.uuid, bdev=str(bdev_name)
+            )
+
+        dbdf = scsi_tgt_info['dbdf']
+        scsi_tgt_num = scsi_tgt_info['scsi_tgt_num']
+        self.spdk_driver.remove_target(bdev_name, dbdf, scsi_tgt_num)
+        delete_controller = self._is_controller_empty(dbdf)
+        self.spdk_driver.bdev_delete(bdev_name)
+
+        # 如果删除了磁盘后，控制器没有磁盘则删除控制器
+        if delete_controller:
+            self.spdk_driver.delete_scsi_controller(dbdf)
+
+    def detach_volume(self, context, connection_info, instance, mountpoint,
+                      encryption=None):
+        LOG.info('dpu driver detach_volume volume_id %s',
+                 connection_info['volume_id'])
+        storage_unready = connection_info.get('storage_unready')
+        LOG.info('flag storage_unready: {}'.format(storage_unready))
+        restart_ssam = connection_info.get('restart_ssam')
+        LOG.info('flag restart_ssam: {}'.format(restart_ssam))
+        if storage_unready:
+            LOG.info('detach_volume echo storage unready')
+            self.spdk_driver.os_unready()
+        try:
+            if not isinstance(self.spdk_driver, spdk_lib.SCSIVolumeDriver):
+                self.detach_blk_volume(context,
+                                       connection_info,
+                                       instance,
+                                       mountpoint,
+                                       encryption=None)
+            else:
+                self.detach_scsi_volume(context,
+                                       connection_info,
+                                       instance,
+                                       mountpoint,
+                                       encryption=None)
+            self._disconnect_volume(connection_info, instance)
+            _run_cmd_by_root(['sync'])
+        except Exception as exc:
+            raise exc
+        finally:
+            if restart_ssam:
+                LOG.info('detach_volume restart spdk')
+                self.spdk_driver.restart()
+
+
+    def extend_volume(self, context, connection_info, instance, requested_size):
+        LOG.info('driver extend volume '
+                 'requested size {}'.format(requested_size))
+
+        if not isinstance(self.spdk_driver, spdk_lib.SCSIVolumeDriver):
+            self._extend_blk_volume(context, connection_info, instance,
+                                    requested_size)
+        else:
+            self._extend_scsi_volume(context, connection_info, instance,
+                                     requested_size)
+        _run_cmd_by_root(['sync'])
+
+    def _get_function_id_by_bdevname(self, bdev_name):
+        # get controllers list
+        controllers_info = self.spdk_driver.get_controllers()
+        controllers = self.spdk_driver.parse_controllers_info(controllers_info)
+
+        for function_id, bdev in controllers.items():
+            if bdev == bdev_name:
+                return function_id
+
+        return None
+
+    def set_bdev_qos(self, connection_info):
+        volume_id = connection_info['volume_id']
+        qos_info = connection_info['data'].get('qos_specs')
+        if qos_info:
+            self.spdk_driver.set_bdev_qos(volume_id, qos_info)
+        LOG.info('Set bdev qos volume_id {}, qos_info {}'.format(volume_id,
+                                                                 qos_info))
+
+    def _refresh_cache(self):
+        LOG.debug('_refresh_cache')
+
+    def _connect_volume(self, data):
+        LOG.debug('Calling os-brick to attach iSCSI Volume')
+        device_info = self.volume_driver.connect_volume(data)
+        if USE_MULTIPATH:
+            device_path = '/dev/disk/by-id/dm-uuid-mpath-' + \
+                          device_info['multipath_id']
+        else:
+            device_path = '/dev/disk/by-path/ip-%s-iscsi-%s-lun-%s' % (
+                data['target_portal'],
+                data['target_iqn'],
+                data['target_lun']
+            )
+        LOG.debug('Attached iSCSI volume device_path %s', device_path)
+        data['device_path'] = device_path
+
+    def _disconnect_volume(self, connection_info, instance):
+        LOG.debug('calling os-brick to detach iSCSI Volume', instance=instance)
+        try:
+            self.volume_driver.disconnect_volume(connection_info['data'], None,
+                                                 True, True)
+        except os_brick_exception.VolumeDeviceNotFound as exc:
+            LOG.warning('Ignoring VolumeDeviceNotFound: %s', exc)
+            return
+        LOG.debug('Disconnected iSCSI Volume', instance=instance)
+
+    def _ob_extend_volume(self, connection_info, instance, requested_size):
+        """Extend the volume."""
+        LOG.debug('calling os-brick to extend iSCSI Volume', instance=instance)
+        new_size = self.volume_driver.extend_volume(connection_info['data'])
+        LOG.debug('Extend iSCSI Volume %s; new_size=%s',
+                  connection_info['volume_id'],
+                  new_size, instance=instance)
+        return new_size
+
+    def _extend_blk_volume(self, context, connection_info, instance,
+                           requested_size):
+        volume_id = connection_info['volume_id']
+        bdev_name = volume_id
+        data = connection_info.get('data')
+        function_id = self._get_function_id_by_bdevname(volume_id)
+        if not function_id:
+            LOG.error('extend_volume PF not found')
+            raise exception.PciDeviceNotFound(
+                node_id=volume_id, address=str(function_id)
+            )
+        if STORAGE_MODE == 'user':
+            self.spdk_driver.bdev_resize(bdev_name, requested_size, function_id)
+        else:
+            self._ob_extend_volume(connection_info, instance, requested_size)
+            self.spdk_driver.bdev_resize(bdev_name, requested_size, function_id)
+
+    def _extend_scsi_volume(self, context, connection_info, instance,
+                            requested_size):
+        volume_id = connection_info['volume_id']
+        bdev_name = volume_id
+        if STORAGE_MODE == 'user':
+            scsi_tgt_info = self._get_scsi_slot_by_bdevname(bdev_name)
+
+            if not scsi_tgt_info:
+                LOG.error('_extend_scsi_volume Controller not found')
+                raise exception.PciDeviceNotFound(
+                    node_id=instance.uuid, bdev=str(bdev_name)
+                )
+
+            dbdf = scsi_tgt_info['dbdf']
+            scsi_tgt_num = scsi_tgt_info['scsi_tgt_num']
+            self.spdk_driver.scsi_bdev_resize(self, dbdf, scsi_tgt_num,
+                                              requested_size)
+        else:
+            self._ob_extend_volume(connection_info, instance, requested_size)
+            self.spdk_driver.bdev_resize(bdev_name, requested_size, None)
+
+    def _mount_share(self, path, mount_dir):
+        LOG.info('mount share to dpu, path = %s, mount_dir = %s', path, mount_dir)
+        cmd = ['mkdir', '-p', mount_dir]
+        _run_cmd_by_root(cmd)
+        cmd = ['mount', '-t', 'nfs', path, mount_dir]
+        _run_cmd_by_root(cmd)
+
+    def _umount_share(self, mount_dir):
+        LOG.info('umount share to dpu, mount_dir = %s', mount_dir)
+        cmd = ['umount', mount_dir]
+        _run_cmd_by_root(cmd)
+        cmd = ['rmdir', mount_dir]
+        _run_cmd_by_root(cmd)
+
+    def attach_share(self, context, instance, share_mapping):
+        """Attach a manila share to the compute node.
+
+        :param context: security context
+        :param instance: nova.objects.instance.Instance
+        :param share_mapping: nova.objects.share_mapping.ShareMapping object
+            that define the share
+        """
+        LOG.info('attach_share share_mapping id : %s, share_id: %s.',
+                 share_mapping.id, share_mapping.share_id, instance=instance)
+        # check export_location
+        LOG.debug('attach_share share_mapping export_location : %s',
+                  share_mapping.export_location)
+        if not share_mapping.export_location:
+            msg = 'attach_share export_location error'
+            LOG.error(msg)
+            raise exception.ShareAttachError(share_id=share_mapping.share_id,
+                                             server_id=instance.uuid,
+                                             reason=msg)
+        # get available pf
+        pf_info = self._get_unused_vfs_pf()
+        if pf_info is None:
+            # 如果PF资源不够就直接返回异常
+            raise exception.PciDeviceRequestFailed(
+                'Not enough PF devices available for allocation'
+            )
+        function_id = pf_info['index']
+        bdf_id = pf_info['dbdf']
+        target = '/mnt/share-' + share_mapping.uuid
+
+        # mount share
+        self._mount_share(share_mapping.export_location, target)
+
+        # spdk
+        try:
+            self.fs_driver.create_fs_controller(bdf_id, target, share_mapping.uuid)
+        except Exception as exc:
+            LOG.error('attach_share spdk error')
+            self._umount_share(target)
+            raise exc
+
+        share_mapping.tag = 'FS_' + str(function_id)
+        if share_mapping.extra == "":
+            extra = {}
+        else:
+            extra = json.loads(share_mapping.extra)
+
+        extra['bdf_id'] = bdf_id
+        share_mapping.extra = jsonutils.dumps(extra)
+        share_mapping.activate()
+        LOG.info('attach_share done')
+
+    def detach_share(self, context, instance, share_mapping):
+        """Detach a manila share from the compute node.
+
+        :param context: security context
+        :param instance: nova.objects.instance.Instance
+        :param share_mapping: nova.objects.share_mapping.ShareMapping object
+            that define the share
+        """
+        LOG.info('detach_share share_mapping id : %s, share_id: %s.',
+                 share_mapping.id, share_mapping.share_id, instance=instance)
+        LOG.debug('detach_share share_mapping export_location : %s',
+                  share_mapping.export_location)
+
+        # 删除控制器
+        self.fs_driver.delete_fs_controller(share_mapping.uuid)
+
+        target = '/mnt/share-' + share_mapping.uuid
+
+        try:
+            self._umount_share(target)
+        except Exception as exc:
+            LOG.error('_umount_share error')
+
+        LOG.info('detach_share done')
