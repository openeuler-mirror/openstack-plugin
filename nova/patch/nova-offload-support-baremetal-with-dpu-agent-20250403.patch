+from oslo_concurrency import processutils
+from oslo_log import log as logging
+
+import nova.conf
+from nova import exception
+from nova import profiler
+from nova import utils
+
+CONF = nova.conf.CONF
+
+LOG = logging.getLogger(__name__)
+MAX_QUEUES = 4
+
+@profiler.trace_cls("ironic_vif_driver")
+class IronicVIFDriver():
+    def _ovs_vsctl(self, args):
+        full_args = ['ovs-vsctl'] + args
+        try:
+            root_helper = utils.get_root_helper()
+            LOG.debug('EXECUTE CMD:%s', ' '.join(full_args))
+            return processutils.execute(*full_args, root_helper=root_helper,
+                                        run_as_root=True)
+        except Exception as e:
+            LOG.error("Unable to execute %(cmd)s. Exception: %(exception)s",
+                      {'cmd': full_args, 'exception': e})
+            raise exception.OVSConfigurationFailure(inner_exception=e)
+
+    def plug_vif(self, port_id, port_name, mac_address, instance_uuid,
+                 port_status, representor, timeout=120, interface_type='dpdk'):
+        bridge = CONF.neutron.ovs_bridge
+        cmd = [
+            '--timeout=%s' % timeout,
+            '--if-exists', 'del-port', port_name, '--',
+            'add-port', bridge, port_name,
+            '--', 'set', 'Interface', port_name,
+            'external-ids:iface-id=%s' % port_id,
+            'external-ids:iface-status=%s' % port_status,
+            'external-ids:attached-mac=%s' % mac_address,
+            'external-ids:vm-uuid=%s' % instance_uuid,
+            'option:dpdk-devargs=%s,representor=%s,max_queues=%s' %
+            ("net_hwsp" + port_name, representor, MAX_QUEUES),
+            'options:n_rxq=4',
+        ]
+        if interface_type:
+            cmd += ['type=%s' % interface_type]
+        out, err = self._ovs_vsctl(cmd)
+        if err:
+            LOG.error("plug_vif fail: %s", err)
+            raise exception.InterfaceAttachFailed(instance_uuid)
+
+    def unplug_vif(self, port_name, instance_uuid, timeout=60):
+        bridge = CONF.neutron.ovs_bridge
+        cmd = ['--timeout=%s' % timeout, '--if-exists', 'del-port', bridge, port_name]
+        out, err = self._ovs_vsctl(cmd)
+        if err:
+            LOG.error("unplug_vif fail: %s", err)
+            raise exception.InterfaceDetachFailed(instance_uuid)
+
+    def show(self, timeout=20):
+        cmd = ['--timeout=%s' % timeout, 'show']
+        out, err = self._ovs_vsctl(cmd)
+        LOG.debug("ovs-vsctl show error: {}, out: {}".format(err, out))
+        return out
