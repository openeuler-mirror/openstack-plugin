+class LibvirtConfigNodeDeviceVpdCap(LibvirtConfigObject):
+
+    def __init__(self, **kwargs):
+        super().__init__(
+            root_name="capability", **kwargs)
+        self._card_name = None
+        self._change_level = None
+        self._manufacture_id = None
