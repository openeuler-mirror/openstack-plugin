+        if vdpa_volume_info:
+            old_dev = vdpa_volume_info.get('old_dev')
+            if old_dev:
+                old_dev_path = old_dev.get('dev_path')
+                migrate_volume_by_pci[old_dev_path] = connection_info
+                migrate_disk_by_pci[old_dev_path] = bdm.as_disk_info()
+
+    for host_dev in hostdev_nodes:
+        # <hostdev mode = 'subsystem' type = 'vdpa' managed = 'no'>
+        #     < source dev = '/dev/vhost-vdpa-4' />
+        # </hostdev>
+        dev_type = host_dev.get('type')
+        if dev_type != 'vdpa':
+            continue
+        source = host_dev.find('source')
+
+        if source is not None:
+            source_dev = source.get('dev')
+            migrate_vif_info = migrate_vif_by_pci.get(source_dev)
+            migrate_volume_info = migrate_volume_by_pci.get(source_dev)
+            migrate_disk_info = migrate_disk_by_pci.get(source_dev)
+            if migrate_vif_info:
+                vif = migrate_vif_info.get_dest_vif()
+                config = get_vif_config(vif=vif)
+            elif migrate_volume_info:
+                LOG.debug("get_volume_config migrate_disk_info %s", migrate_disk_info)
+                config = get_volume_config(migrate_volume_info, migrate_disk_info)
+        else:
+            # This shouldn't happen but if it does, we need to abort the
