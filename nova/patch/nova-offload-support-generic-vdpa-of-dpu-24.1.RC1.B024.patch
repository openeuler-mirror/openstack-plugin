+"""
+Libvirt volume driver for direct device
+"""
+
+import typing
+
+from os_brick import initiator
+from os_brick.initiator import connector
+from oslo_log import log as logging
+
+import nova.conf
+from nova import utils
+from nova.pci import utils as pci_utils
+from nova.virt.libvirt import config as vconfig
+from nova.virt.libvirt.volume import volume as libvirt_volume
+
+LOG = logging.getLogger(__name__)
+
+CONF = nova.conf.CONF
+SUPPORT_VOL_DRIVER = ('rbd', 'iscsi')
+
+class LibvirtVDPAVolumeDriver(libvirt_volume.LibvirtBaseVolumeDriver):
+    """Driver to attach direct device volumes to libvirt."""
+
+    def __init__(self, host):
+        super(LibvirtVDPAVolumeDriver, self).__init__(host,
+                                                       is_block_dev=True)
+        self.connector = connector.InitiatorConnector.factory(
+            initiator.VDPA, utils.get_root_helper(),
+            use_multipath=CONF.libvirt.volume_use_multipath,
+            device_scan_attempts=CONF.libvirt.num_volume_scan_tries,
+            transport=self._get_transport())
+
+    def attach_volume(self, connection_info, instance):
+        """Attach the volume to instance_name."""
+        vdpa_volume_info = connection_info['data'].get('vdpa_volume_info')
+        # 这个driver_volume_type是指后端存储，在此处是iscsi或者rbd
+        # vdpa_volume_type是存储在connection_info['data'].get('vdpa_volume_info')
+        driver_volume_type = connection_info.get('driver_volume_type')
+        # 说明使用的是vdpa_volume并且后端存储可供支持
+        if vdpa_volume_info and driver_volume_type in SUPPORT_VOL_DRIVER:
+            LOG.debug('Calling os-brick to attach VDPA Volume', instance=instance)
+            self.connector.attach_volume(connection_info)
+            LOG.debug("Connected VDPA Volume", instance=instance)
+
+    def detach_volume(self, connection_info, instance):
+        """Detach the volume from instance_name."""
+        vdpa_volume_info = connection_info['data'].get('vdpa_volume_info')
+        driver_volume_type = connection_info.get('driver_volume_type')
+        if vdpa_volume_info and driver_volume_type in SUPPORT_VOL_DRIVER:
+            LOG.debug("Calling os-brick to detach VDPA Volume.", instance=instance)
+            self.connector.detach_volume(connection_info)
+            LOG.debug("Disconnected VDPA Volume", instance=instance)
+
+    def extend_volume(self, connection_info, instance, requested_size):
+        """Extend the volume."""
+        vdpa_volume_info = connection_info['data'].get('vdpa_volume_info')
+        driver_volume_type = connection_info.get('driver_volume_type')
+        if vdpa_volume_info and driver_volume_type in SUPPORT_VOL_DRIVER:
+            LOG.debug("Calling os-brick to extend VDPA Volume.",
+                      instance=instance)
+            self.connector.extend_volume(
+                connection_info, instance, requested_size)
+            LOG.debug("Extended VDPA Volume", instance=instance)
+
+    def get_config(self, connection_info, disk_info):
+        vdpa_volume_info = connection_info['data'].get('vdpa_volume_info')
+        driver_volume_type = connection_info.get('driver_volume_type')
+
+        if vdpa_volume_info and driver_volume_type in SUPPORT_VOL_DRIVER:
+            conf = vconfig.LibvirtConfigGuestVDPAPCI()
+            pci_slot = vdpa_volume_info['pci']
+            dev_path = vdpa_volume_info.get('dev_path')
+
+            if not dev_path:
+                dev_path = self._get_vdpa_dev_path(pci_slot)
+
+            dbsf = pci_utils.parse_address(pci_slot)
+            conf.domain, conf.bus, conf.slot, conf.function = dbsf
+            conf.source_dev = dev_path
