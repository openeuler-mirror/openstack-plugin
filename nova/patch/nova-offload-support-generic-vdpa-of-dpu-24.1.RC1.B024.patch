+
+    @property
+    def asset_tag(self):
+        return self._asset_tag
+
+    @property
+    def ro_vendor_fields(self):
+        return self._ro_vendor_fields
+
+    @property
+    def rw_vendor_fields(self):
+        return self._rw_vendor_fields
+
+    @property
