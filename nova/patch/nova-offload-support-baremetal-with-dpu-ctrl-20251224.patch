+import json
+import requests
+import time
+
+from oslo_config import cfg
+from oslo_log import log as logging
+
+CONF = cfg.CONF
+LOG = logging.getLogger(__name__)
+
+class APIClient(object):
+    def __init__(self, api_url):
+        self.api_url = api_url.rstrip('/')
+        self.api_version = "v2"
+
+        # Only keep alive a maximum of 2 connections to the API. More will be
+        # opened if they are needed, but they will be closed immediately after
+        # use.
+        adapter = requests.adapters.HTTPAdapter(pool_connections=2,
+                                                pool_maxsize=2)
+        self.session = requests.Session()
+        self.session.mount(self.api_url, adapter)
+
+        self.encoder = json.JSONEncoder()
+
+        self.token_update_time = 0
+        self.token = ''
+        self._init_auth_conf()
+        self.project_id = None
+
+    def _init_auth_conf(self):
+        # nova-api初始化的时候就会执行到这里，此时有keystone_authtoken，但下面没啥东西。
+        # nova-compute没有keystone_authtoken
+        if hasattr(CONF, 'keystone_authtoken'):
+            LOG.debug('APIClient no need to init auth_conf')
+            return
+        group = cfg.OptGroup('keystone_authtoken')
+        opts = [
+            cfg.StrOpt('username', default=''),
+            cfg.StrOpt('project_domain_name', default=''),
+            cfg.StrOpt('user_domain_name', default=''),
+            cfg.StrOpt('project_name', default=''),
+            cfg.StrOpt('password', default=''),
+            cfg.StrOpt('auth_url', default=''),
+        ]
+        try:
+            CONF.register_group(group)
+            CONF.register_opts(opts, group=group)
+            CONF(default_config_files=['/etc/nova/nova.conf'])
+        except cfg.DuplicateOptError:
+            LOG.warning('cfg DuplicateOptError')
+
+    def _get_token(self):
+        ka = CONF.keystone_authtoken
+        username = ka.username.lower()
+        project_domain_name = ka.project_domain_name.lower()
+        user_domain_name = ka.user_domain_name.lower()
+        project_name = ka.project_name.lower()
+        password = ka.password
+        self.auth_data = json.dumps({
+            "auth": {
+                "identity": {
+                    "methods": ["password"],
+                    "password": {
+                        "user": {
+                            "name": username,
+                            "domain": {"id": user_domain_name},
+                            "password": password
+                        }
+                    }
+                },
+                "scope": {
+                    "project": {
+                        "name": project_name,
+                        "domain": {"id": project_domain_name}
+                    }
+                }
+            }
+        })
+        self.auth_url = ka.auth_url + "/identity/v3/auth/tokens"
+
+        if self.token_update_time < time.time() - 5 * 60:  # 5分钟过期，重新获取
+            headers = {
+                'Content-Type': 'application/json',
+                'Accept': 'application/json',
+            }
+            response = self.session.request('POST',
+                                            self.auth_url,
+                                            headers=headers,
+                                            data=self.auth_data,
+                                            verify=None,
+                                            cert=None)
+            self.token_update_time = time.time()
+            self.token = response.headers['X-Subject-Token']
+            LOG.debug('get token success')
+
+        if self.project_id is None:
+            self._init_project_id(self.token)
+
+        return self.token
+
+    def _init_project_id(self, token):
+        ka = CONF.keystone_authtoken
+        project_name = ka.project_name.lower()
+        path = ka.auth_url + '/v3/projects?name={}'.format(project_name)
+
+        headers = {
+            'Content-Type': 'application/json',
+            'Accept': 'application/json',
+            'X-Auth-Token': token,
+        }
+        response = self.session.request('GET', path,
+                                        headers=headers,
+                                        verify=None,
+                                        cert=None)
+
+        projects = json.loads(response.content).get("projects", [{}])
+        project = projects[0]
+        project_id = project.get('id')
+        self.project_id = project_id
+        LOG.debug('manila api token project_id: %s ', project_id)
+
+    def _request(self, method, path, data=None, headers=None, **kwargs):
+        request_url = '{api_url}{path}'.format(api_url=self.api_url, path=path)
+
+        if data is not None:
+            data = self.encoder.encode(data)
+
+        headers = headers or {}
+        token = self._get_token()
+        headers.update({
+            'Content-Type': 'application/json',
+            'Accept': 'application/json',
+            'X-Auth-Token': token,
+            'X-Openstack-Manila-Api-Version': '2.51',
+        })
+
+        return self.session.request(method,
+                                    request_url,
+                                    headers=headers,
+                                    data=data,
+                                    verify=None,
+                                    cert=None,
+                                    **kwargs)
+
+    def manila_get_share(self, share_id):
+        self._get_token()
+        path = '/{}/{}/shares/{}'.format(self.api_version, self.project_id,
+                                         share_id)
+        try:
+            response = self._request('GET', path)
+        except Exception as err:
+            LOG.error('Unhandled error manila_get_share. Error: %s ', err)
+            raise
+
+        # Got valid content
+        return response
+
+    def manila_export_locations(self, share_id):
+        self._get_token()
+        path = '/{}/{}/shares/{}/export_locations'.format(self.api_version,
+                                                          self.project_id,
+                                                          share_id)
+        try:
+            response = self._request('GET', path)
+        except Exception as err:
+            LOG.error('Unhandled error manila_export_locations. Error: %s ', err)
+            raise
+
+        # Got valid content
+        return response
+
+    def manila_list_access(self, share_id):
+        self._get_token()
+        path = '/{}/{}/share-access-rules?share_id={}'.format(self.api_version, self.project_id, share_id)
+        try:
+            response = self._request('GET', path)
+        except Exception as err:
+            LOG.error('Unhandled error manila_list_access. Error: %s ',
+                      err)
+            raise
+
+        # Got valid content
+        return response
+
+    def manila_allow_access(self, share_id, data):
+        self._get_token()
+        path = '/{}/{}/shares/{}/action'.format(self.api_version, self.project_id, share_id)
+        try:
+            response = self._request('POST', path, data=data)
+        except Exception as err:
+            LOG.error('Unhandled error manila_allow_access. Error: %s ', err)
+            raise
+
+        # Got valid content
+        return response
+
+    def manila_deny_access(self, share_id, data):
+        self._get_token()
+        path = '/{}/{}/shares/{}/action'.format(self.api_version, self.project_id, share_id)
+        try:
+            response = self._request('POST', path, data=data)
+        except Exception as err:
+            LOG.error('Unhandled error manila_deny_access. Error: %s ', err)
+            raise
+
+        # Got valid content
+        return response
