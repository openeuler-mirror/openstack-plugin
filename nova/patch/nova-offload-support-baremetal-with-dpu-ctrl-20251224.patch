+    def attach_share(self, context, instance, share_mapping):
+        """Attach a manila share to the compute node.
+
+        :param context: security context
+        :param instance: nova.objects.instance.Instance
+        :param share_mapping: nova.objects.share_mapping.ShareMapping object
+            that define the share
+        """
+        LOG.info('attach_share share_mapping id : %s, share_id: %s.',
+                 share_mapping.id, share_mapping.share_id, instance=instance)
+        self._check_state_validation(instance)
+
+        share_proto = share_mapping.share_proto
+        if share_proto != "NFS":
+            msg = "Unsupported share protocol: {}".format(share_proto)
+            LOG.error(msg, instance=instance)
+            raise exception.ShareProtocolNotSupported(
+                share_id=share_mapping.share_id, protocol=share_proto)
+
+        response = self._attach_share_dpu(instance, share_mapping.share_id)
+        LOG.info('attach_share response: %(response)s.',
+                 {'response': response}, instance=instance)
+        if response.status_code != requests.codes.OK:
+            raise exception.ShareAttachError(share_id=share_mapping.share_id,
+                                             server_id=instance.uuid,
+                                             reason=response.content)
+
+    def _attach_share_dpu(self, instance, share_id):
+        manager_url = self._get_dpu_manager_url(instance)
+        apiclient = dpu_api.APIClient(manager_url)
+        data = {
+            'shareAttachment': {
+                'share_id': share_id,
+            }
+        }
+        response = apiclient.attach_share_dpu(instance.uuid, data)
+        return response
