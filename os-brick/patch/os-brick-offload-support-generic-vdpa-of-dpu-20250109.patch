index 0000000..7c31350
--- /dev/null
+++ b/os_brick/initiator/connectors/vdpa.py
@@ -0,0 +1,341 @@
+# Copyright 2024 Huawei Technology corp.
+#
+#    Licensed under the Apache License, Version 2.0 (the "License"); you may
+#    not use this file except in compliance with the License. You may obtain
+#    a copy of the License at
+#
+#         http://www.apache.org/licenses/LICENSE-2.0
+#
+#    Unless required by applicable law or agreed to in writing, software
+#    distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+#    WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+#    License for the specific language governing permissions and limitations
+#    under the License.
+
+import json
+
+from oslo_concurrency import lockutils
+from oslo_concurrency import processutils as putils
+from oslo_log import log as logging
+import logging as ori_logging
+
+from os_brick import exception
+from os_brick import spdk_lib
+from os_brick import initiator
+from os_brick.initiator import connector
+from os_brick.initiator.connectors import base
+from oslo_concurrency import processutils
+from nova import utils as novautils
+from nova import exception as nova_exception
+
+synchronized = lockutils.synchronized_with_prefix('os-brick-')
+
+LOG = logging.getLogger(__name__)
+
+# disable processutils log
+ori_logging.getLogger('oslo_concurrency.processutils').\
+    setLevel(ori_logging.CRITICAL)
+
+STORAGE_MODE = 'kernel'
+
+def _run_cmd_by_root(cmd, log_cmd=True):
+    # 基于rootwrap机制运行，以rootwrap配置文件中配置的权限运行
+    try:
+        root_helper = novautils.get_root_helper()
+        if log_cmd:
+            LOG.debug('EXECUTE CMD:%s', ' '.join(cmd))
+        return processutils.execute(*cmd, root_helper=root_helper,
+                                    run_as_root=True)
+    except processutils.ProcessExecutionError as e:
+        raise nova_exception.ProcessExecuteException(
+            cmd=(' '.join(cmd) if log_cmd else ""),
+            reason=(e if log_cmd else e.exit_code)
+        ) from None
+
+# 当前不考虑virtio-scsi
+class VDPAConnector(base.BaseLinuxConnector):
+    """Connector class to attach/detach VDPA volumes."""
+    # rootwrap中的名字，实际以rootwrap中配置的绝对路径运行。
+    smi_path = 'dpak-smi'
+
+    def __init__(self, root_helper, driver=None, execute=putils.execute,
+                 use_multipath=False, *args, **kwargs):
+
+        super(VDPAConnector, self).__init__(root_helper, driver=driver,
+                                            execute=execute, *args, **kwargs)
+        self.use_multipath = use_multipath
+        self.volume_driver = \
+            connector.InitiatorConnector.factory(initiator.ISCSI,
+                                                 novautils.get_root_helper(),
+                                                 use_multipath=self.use_multipath)
+        self.initiator_iqn = self.volume_driver.get_initiator()
+        self.spdk_driver = spdk_lib.BLKVolumeDriver(self.initiator_iqn,
+                                                    storage_mode=STORAGE_MODE)
+
+    def connect_volume(self, connection_info, instance):
+        self.volume_driver.connect_volume(connection_info, instance)
+        LOG.error('ISCSI volume driver has connected the volume!')
+
+    def disconnect_volume(self, connection_info, instance):
+        self.volume_driver.disconnect_volume(connection_info, instance)
+        LOG.error('ISCSI volume driver has disconnected the volume!')
+
+    def get_volume_paths(self, connection_properties):
+        LOG.error('Not implemented')
+        return None
+
+    def get_search_path(self):
+        LOG.error('Not implemented')
+        return None
+
+    def _get_pfs_info_by_type(self, type):
+        cmd = [self.smi_path, 'info', '-t', 'device_pcie_list', '-f', type]
+        out, err = _run_cmd_by_root(cmd)
+        try:
+            pf_infos = json.loads(out)
+        except Exception as e:
+            LOG.error("Get pf info error: {}".format(e))
+            return []
+        LOG.debug("pf infos: {}".format(pf_infos))
+        return pf_infos
+
+    def attach_blk_volume(self, connection_info):
+        vdpa_volume_info = connection_info['data'].get('vdpa_volume_info')
+        # 能够进入这段代码，前面的逻辑已经保证存在vdpa_volume_info字段
+        dbdf = vdpa_volume_info.get('pci')
+        volume_id = connection_info['volume_id']
+        bdev_name = volume_id
+        data = connection_info['data']
+        self.spdk_driver.bdev_create(connection_info)
+        qos_info = data.get('qos_specs')
+        if qos_info:
+            self.spdk_driver.set_bdev_qos(volume_id, qos_info)
+
+        self.spdk_driver.create_blk_controller(dbdf, bdev_name, volume_id)
+
+    def _get_storage_pfs(self):
+        pf_infos = self._get_pfs_info_by_type('storage')
+        pfs = []
+        for pf_info in pf_infos:
+            pfs.append(pf_info['dbdf'])
+
+        return pfs
+
+    def _get_available_slots(self):
+        # get controllers list
+        controllers_info = self.spdk_driver.get_controllers()
+        controllers = self.spdk_driver.parse_controllers_info(controllers_info)
+
+        available_pfs = self._get_storage_pfs()
+        slots = {}
+        max_slots = self.spdk_driver.MAX_SCSI_SLOTS
+
+        for dbdf, scsi_targets in controllers.items():
+            available_pfs.remove(dbdf)
+            if len(scsi_targets) == max_slots:
+                continue
+
+            scsi_targets_unused = list(range(max_slots))
+
+            for scsi_target_num in scsi_targets.keys():
+                scsi_targets_unused.remove(scsi_target_num)
+
+            slots[dbdf] = scsi_targets_unused
+
+        # sort by available slots number
+        if slots:
+            available_controllers = sorted(slots.items(),
+                                           key=lambda item: len(item[1]),
+                                           reverse=True)
+            # return the available pfs and the most idle controller
+            return available_pfs, available_controllers[0]
+
+        return available_pfs, []
+
+    def _get_slots_to_attach(self):
+        available_pfs, available_slots = self._get_available_slots()
+        slots_to_attach = {}
+        if not available_pfs:
+            if not available_slots:
+                # 说明当前系统中所有的PF都被用来创建控制器并且没有可用的槽
+                raise nova_exception.PciDeviceRequestFailed(
+                    "Not enough PF devices available for allocation"
+                )
+            # 说明还有可用的槽，则返回对应的一个控制器及其可用槽位
+            function_id = available_slots[0]
+            scsi_tgt_num = available_slots[1][0]
+        else:
+            function_id = available_pfs[0]
+            scsi_tgt_num = 0
+            self.spdk_driver.create_controller(function_id)
+
+        slots_to_attach['function_id'] = function_id
+        slots_to_attach['scsi_tgt_num'] = scsi_tgt_num
+
+        return slots_to_attach
+
+    def attach_scsi_volume(self, connection_info):
+        volume_id = connection_info['volume_id']
+        bdev_name = volume_id
+        data = connection_info['data']
+
+        self.spdk_driver.bdev_create(connection_info)
+        qos_info = data.get('qos_specs')
+        if qos_info:
+            self.spdk_driver.set_bdev_qos(volume_id, qos_info)
+
+        slots_to_attach = self._get_slots_to_attach()
+        dbdf = slots_to_attach['dbdf']
+        scsi_tgt_num = slots_to_attach['scsi_tgt_num']
+        self.spdk_driver.add_target(bdev_name, dbdf, scsi_tgt_num)
+
+    def _connect_volume(self, data):
+        LOG.debug("Calling os-brick to attach iSCSI Volume")
+        device_info = self.volume_driver.connect_volume(data)
+        LOG.debug("Attached iSCSI volume %s", device_info)
+        if self.use_multipath:
+            device_path = "/dev/disk/by-id/dm-uuid-mpath-" + \
+                          device_info['multipath_id']
+        else:
+            device_path = "/dev/disk/by-path/ip-%s-iscsi-%s-lun-%s" % (
+                data['target_portal'],
+                data['target_iqn'],
+                data['target_lun']
+            )
+        LOG.debug("Attached iSCSI volume device_path %s", device_path)
+        data['device_path'] = device_path
+
+    def _disconnect_volume(self, connection_info):
+        LOG.debug("calling os-brick to detach iSCSI Volume")
+        try:
+            self.volume_driver.disconnect_volume(connection_info['data'], None)
+        except exception.VolumeDeviceNotFound as exc:
+            LOG.warning('Ignoring VolumeDeviceNotFound: %s', exc)
+            return
+        LOG.debug("Disconnected iSCSI Volume")
+
+    def _ob_extend_volume(self, connection_info):
+        """Extend the volume."""
+        LOG.debug('calling os-brick to extend iSCSI Volume')
+        new_size = self.volume_driver.extend_volume(connection_info['data'])
+        LOG.debug('Extend iSCSI Volume %s; new_size=%s',
+                  connection_info['volume_id'], new_size)
+        return new_size
+
+    def attach_volume(self, connection_info):
+        LOG.info("dpu driver attach_volume volume_id {}".format(
+                 connection_info['volume_id']))
+        connection_info['initiator_iqn'] = self.initiator_iqn
+        # iscsiadm connect to target
+        driver_volume_type = connection_info['driver_volume_type']
+        if driver_volume_type == 'iscsi' and self.spdk_driver.STORAGE_MODE == 'kernel':
+            self._connect_volume(connection_info['data'])
+        if not isinstance(self.spdk_driver, spdk_lib.SCSIVolumeDriver):
+            self.attach_blk_volume(connection_info)
+        else:
+            self.attach_scsi_volume(connection_info)
+
+    def detach_blk_volume(self, connection_info):
+        # 获取function_id
+        vdpa_volume_info = connection_info['data'].get('vdpa_volume_info')
+        dbdf = vdpa_volume_info.get('pci')
+
+        volume_id = connection_info['volume_id']
+        # 删除控制器
+        self.spdk_driver.delete_controller(dbdf)
+        # 删除bdev
+        self.spdk_driver.bdev_delete(connection_info, volume_id)
+
+    def _get_scsi_slot_by_bdevname(self, bdev_name):
+        controllers_info = self.spdk_driver.get_controllers()
+        controllers = self.spdk_driver.parse_controllers_info(controllers_info)
+        scsi_tgt_info = {}
+
+        for dbdf, scsi_targets in controllers.items():
+            for scsi_tgt_num, bdev in scsi_targets.items():
+                if bdev == bdev_name:
+                    scsi_tgt_info['scsi_tgt_num'] = scsi_tgt_num
+                    scsi_tgt_info['dbdf'] = dbdf
+                    return scsi_tgt_info
+
+        return None
+
+    def detach_scsi_volume(self, connection_info):
+        volume_id = connection_info['volume_id']
+        bdev_name = volume_id
+        scsi_tgt_info = self._get_scsi_slot_by_bdevname(bdev_name)
+
+        if not scsi_tgt_info:
+            LOG.error('Controller not found')
+            raise exception.PciDeviceNotFound(bdev=str(bdev_name))
+
+        dbdf = scsi_tgt_info['dbdf']
+        scsi_tgt_num = scsi_tgt_info['scsi_tgt_num']
+        self.spdk_driver.remove_target(bdev_name, dbdf, scsi_tgt_num)
+        delete_controller = self._is_controller_empty(dbdf)
+        self.spdk_driver.bdev_delete(bdev_name)
+
+        # 如果删除了磁盘后，控制器没有磁盘则删除控制器
+        if delete_controller:
+            self.spdk_driver.delete_scsi_controller(dbdf)
+
+    def detach_volume(self, connection_info):
+        # 获取function_id
+        LOG.info("volume driver detach_volume volume_id {}".format(
+                 connection_info['volume_id']))
+        if not isinstance(self.spdk_driver, spdk_lib.SCSIVolumeDriver):
+            self.detach_blk_volume(connection_info)
+        else:
+            self.detach_scsi_volume(connection_info)
+
+        driver_volume_type = connection_info['driver_volume_type']
+        if driver_volume_type == 'iscsi' and self.spdk_driver.STORAGE_MODE == 'kernel':
+            self._disconnect_volume(connection_info)
+        _run_cmd_by_root(["sync"])
+
+    def extend_volume(self, connection_info, instance, requested_size):
+        LOG.info("driver extend volume "
+                 "requested size {}".format(requested_size))
+
+        if not isinstance(self.spdk_driver, spdk_lib.SCSIVolumeDriver):
+            self._extend_blk_volume(connection_info, instance, requested_size)
+        else:
+            self._extend_scsi_volume(connection_info, instance, requested_size)
+        _run_cmd_by_root(["sync"])
+
+    def _extend_blk_volume(self, connection_info, instance, requested_size):
+        volume_id = connection_info.get('volume_id')
+        bdev_name = volume_id
+        vdpa_volume_info = connection_info['data'].get('vdpa_volume_info')
+        dbdf = vdpa_volume_info.get('pci')
+        function_id = dbdf
+
+        driver_volume_type = connection_info['driver_volume_type']
+        if driver_volume_type == 'iscsi' and \
+                self.spdk_driver.STORAGE_MODE == "kernel":
+            self._ob_extend_volume(connection_info)
+        self.spdk_driver.bdev_resize(
+            driver_volume_type, bdev_name, requested_size, function_id)
+
+    def _extend_scsi_volume(self, connection_info, instance, requested_size):
+        volume_id = connection_info['volume_id']
+        bdev_name = volume_id
+        driver_volume_type = connection_info['driver_volume_type']
+        if driver_volume_type == 'iscsi' and \
+                self.spdk_driver.STORAGE_MODE == 'user':
+            scsi_tgt_info = self._get_scsi_slot_by_bdevname(bdev_name)
+
+            if not scsi_tgt_info:
+                LOG.error('_extend_scsi_volume Controller not found')
+                raise exception.PciDeviceNotFound(
+                    node_id=instance.uuid, bdev=str(bdev_name)
+                )
+
+            dbdf = scsi_tgt_info['dbdf']
+            scsi_tgt_num = scsi_tgt_info['scsi_tgt_num']
+            self.spdk_driver.scsi_bdev_resize(self, dbdf, scsi_tgt_num,
+                                              requested_size)
+        else:
+            if driver_volume_type == 'iscsi':
+                self._ob_extend_volume(connection_info)
+            self.spdk_driver.bdev_resize(bdev_name, requested_size, None)
