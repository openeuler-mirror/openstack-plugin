+#    WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+#    License for the specific language governing permissions and limitations
+#    under the License.
+
+"""
+A library wrapping the spdk API
+"""
+
+import abc
+import json
+import math
+
+from oslo_log import log as logging
+from oslo_concurrency import processutils
+
+from nova import exception
+from nova import utils
+
+LOG = logging.getLogger(__name__)
+
+def _run_cmd_by_root(cmd, log_cmd=True):
+    # 基于rootwrap机制运行，以rootwrap配置的权限运行
+    try:
+        root_helper = utils.get_root_helper()
+        if log_cmd:
+            LOG.debug('EXECUTE CMD:%s', ' '.join(cmd))
+        return processutils.execute(*cmd, root_helper=root_helper,
+                                    run_as_root=True)
+    except processutils.ProcessExecutionError as e:
+        raise exception.ProcessExecuteException(
+            cmd=(' '.join(cmd) if log_cmd else ""),
+            reason=(e if log_cmd else e.exit_code)
+        ) from None
+
+class BaseSPDKVolumeDriver(object):
+    # rootwrap中的名字，实际以rootwrap中配置的绝对路径运行。
+    spdk_rpc_path = 'hw_dpu_rpc.py'  # '/usr/libexec/spdk/scripts/hw_dpu_rpc.py'
+    rpc_path = 'rpc.py'  # '/usr/libexec/spdk/scripts/rpc.py'
+    smi_path = 'dpak-smi'
+    qos_bytes_map = dict(total_bytes_sec='--rw_mbytes_per_sec',
+                         read_bytes_sec='--r_mbytes_per_sec',
+                         write_bytes_sec='--w_mbytes_per_sec')
+    qos_iops_map = dict(total_iops_sec='--rw_ios_per_sec')
+
+    BYTES_MIN = 1 * 1024 * 1024
+    IOPS_MIN = 1000
+    MiB = 1024 * 1024
+    BDEV_BLOCK_SIZE = 512
+
+    def __init__(self, initiator_iqn, storage_mode='user'):
+        super(BaseSPDKVolumeDriver, self).__init__()
+        self.initiator_iqn = initiator_iqn
+        self.STORAGE_MODE = storage_mode
+
+    def os_ready(self):
+        cmd = [self.spdk_rpc_path, 'os_ready']
+        _run_cmd_by_root(cmd)
+
+    def bdev_create(self, connection_info):
+        driver_volume_type = connection_info['driver_volume_type']
+        if driver_volume_type == 'rbd':
+            self.bdev_rbd_create(connection_info)
+        else:
+            if self.STORAGE_MODE == 'user':
+                self.bdev_user_create(connection_info)
+            elif self.STORAGE_MODE == 'kernel':
+                self.bdev_aio_create(connection_info)
+
+    def bdev_delete(self, connection_info, bdev_name):
+        driver_volume_type = connection_info['driver_volume_type']
+        if driver_volume_type == 'rbd':
+            self.bdev_rbd_delete(bdev_name)
+        else:
+            if self.STORAGE_MODE == 'user':
+                self.bdev_user_delete(bdev_name)
+            elif self.STORAGE_MODE == 'kernel':
+                self.bdev_aio_delete(bdev_name)
+
+    def bdev_rbd_create(self, connection_info):
+        bdev_name = connection_info['volume_id']
+        user = connection_info['data']['auth_username']
+        pool, volume_name = connection_info['data']['name'].split('/')
+        cmd = [self.rpc_path, 'bdev_rbd_create', '--name', bdev_name, '--user',
+               user, pool, volume_name, str(self.BDEV_BLOCK_SIZE)]
+        _run_cmd_by_root(cmd)
+
+    def bdev_rbd_delete(self, bdev_name):
+        cmd = [self.rpc_path, 'bdev_rbd_delete', bdev_name]
+        _run_cmd_by_root(cmd)
+
+    def bdev_aio_create(self, connection_info):
+        device_path = connection_info['data'].get('device_path')
+        bdev_name = connection_info['volume_id']
+        cmd = [self.rpc_path, 'bdev_aio_create', device_path, bdev_name]
+        _run_cmd_by_root(cmd)
+
+    def bdev_aio_delete(self, bdev_name):
+        cmd = [self.rpc_path, 'bdev_aio_delete', bdev_name]
+        _run_cmd_by_root(cmd)
+
+    def bdev_user_create(self, connection_info):
+        data = connection_info['data']
+        bdev_name = connection_info['volume_id']
+
+        # 创建用户态bdev
+        if data.get('auth_username'):
+            temp = 'iscsi://{username}%{password}@{target_portal}/' \
+                   '{target_iqn}/{target_lun}'
+            url_for_run = temp.format(username=data['auth_username'],
+                                      password=data['auth_password'],
+                                      target_portal=data['target_portal'],
+                                      target_iqn=data['target_iqn'],
+                                      target_lun=data['target_lun'])
+            url_for_log = temp.format(username='username',
+                                      password='xxxxxxxx',
+                                      target_portal=data['target_portal'],
+                                      target_iqn=data['target_iqn'],
+                                      target_lun=data['target_lun'])
+        else:
+            temp = 'iscsi://{target_portal}/{target_iqn}/{target_lun}'
+            url_for_run = temp.format(target_portal=data['target_portal'],
+                                      target_iqn=data['target_iqn'],
+                                      target_lun=data['target_lun'])
+            url_for_log = url_for_run
+
+        cmd_for_run = [self.rpc_path, 'bdev_iscsi_create', '-b', bdev_name,
+                       '-i', self.initiator_iqn, '--url', url_for_run]
+        cmd_for_log = cmd_for_run[:-1] + [url_for_log]
+        LOG.debug('EXECUTE CMD:%s', ' '.join(cmd_for_log))
+        _run_cmd_by_root(cmd_for_run, log_cmd=False)
+
+    def bdev_user_delete(self, bdev_name):
+        cmd = [self.rpc_path, 'bdev_iscsi_delete', bdev_name]
+        _run_cmd_by_root(cmd)
+
+    def _convert_qos_bytes(self, bytes_sec):
+        if bytes_sec < self.BYTES_MIN:
+            LOG.warning('bytes_sec < BYTES_MIN, use %d' % self.BYTES_MIN)
+            bytes_sec = self.BYTES_MIN
+        mbytes_sec = int(bytes_sec / self.MiB)
+        return mbytes_sec
+
+    def _convert_qos_iops(self, iops_sec):
+        if iops_sec < self.IOPS_MIN:
+            LOG.warning('iops_sec < IOPS_MIN, use %d' % self.IOPS_MIN)
+            iops_sec = self.IOPS_MIN
+        iops_sec = math.ceil(iops_sec / 1000) * 1000
+        return iops_sec
+
+    def set_bdev_qos(self, volume_id, qos_info):
+        try:
+            self._set_bdev_qos(volume_id, qos_info)
+        except Exception as ex:
+            LOG.warning('Set qos failed, volume_id: %s, reason: %s',
+                        volume_id, ex)
+
+    def _set_bdev_qos(self, volume_id, qos_info):
+        LOG.info('Set bdev volume_id %s, qos_info %s', volume_id, qos_info)
+        if not qos_info:
+            LOG.debug('No qos_info')
+            return
+
+        qos_cmdline = [self.rpc_path, 'bdev_set_qos_limit']
+        qos_cmdline_len = len(qos_cmdline)
+        for qos_set in qos_info:
+            if qos_set in self.qos_bytes_map:
+                qos_bytes = int(qos_info[qos_set])
+                qos_mbytes = self._convert_qos_bytes(qos_bytes)
+                qos_cmdline += [self.qos_bytes_map[qos_set], str(qos_mbytes)]
+            if qos_set in self.qos_iops_map:
+                qos_iops = int(qos_info[qos_set])
+                qos_iops = self._convert_qos_iops(qos_iops)
+                qos_cmdline += [self.qos_iops_map[qos_set], str(qos_iops)]
+        if len(qos_cmdline) != qos_cmdline_len:
+            qos_cmdline.append(volume_id)
+            _run_cmd_by_root(qos_cmdline)
+        else:
+            LOG.warning('No valid qos info')
+
+    def bdev_resize(self, driver_volume_type, bdev_name, requested_size, function_id):
+        """
+        Resize the bdev to the requested_size
+        """
+        new_size_in_mb = requested_size
+        if driver_volume_type == 'rbd':
+            cmd = [self.rpc_path, 'bdev_rbd_resize', bdev_name, str(new_size_in_mb)]
+            _run_cmd_by_root(cmd)
+        else:
+            if self.STORAGE_MODE == 'user':
+                cmd = [self.spdk_rpc_path, 'bdev_resize', str(function_id),
+                       str(new_size_in_mb)]
+                _run_cmd_by_root(cmd)
+            elif self.STORAGE_MODE == 'kernel':
+                cmd = [self.spdk_rpc_path, 'bdev_aio_resize', bdev_name,
+                       str(new_size_in_mb)]
+                _run_cmd_by_root(cmd)
+            else:
+                LOG.error('Spdk driver does not support resizing bdev by command')
+                raise NotImplementedError()
+
+    def get_controllers(self, function_id=None):
+        """
+        Execute the command if getting controllers
+
+        returns: The detail information of controllers
+        """
+        # 获取控制器列表
+        get_controllers_cmd = [self.spdk_rpc_path, 'get_controllers']
+        if function_id:
+            get_controllers_cmd.extend(['-f', function_id])
+
+        out, err = _run_cmd_by_root(get_controllers_cmd)
+        controllers_info = json.loads(out)
+
+        return controllers_info
+
+    def delete_controller(self, function_id):
+        """
+        Execute the command of deleting a controller
+        """
+        del_controller_cmd = [self.spdk_rpc_path, 'delete_controller',
+                              str(function_id)]
+        _run_cmd_by_root(del_controller_cmd)
+
+    @abc.abstractmethod
+    def parse_controllers_info(self):
+        """
+        Parse the detail information of controllers and extract the important
+        information such as function_id and the bdev attached.
+
+        :returns: The dict of the important information of controllers
+        """
+
+class SCSIVolumeDriver(BaseSPDKVolumeDriver):
+    def __init__(self, initiator_iqn, storage_mode='kernel'):
+        super(SCSIVolumeDriver, self).__init__(initiator_iqn,
+                                               storage_mode=storage_mode)
+        self.MAX_SCSI_SLOTS = 8
+
+    def create_scsi_controller(self, dbdf):
+        controller_name = 'controller_' + dbdf
+        create_controller_cmd = [self.spdk_rpc_path, 'create_scsi_controller',
+                                 dbdf, controller_name]
+        _run_cmd_by_root(create_controller_cmd)
+
+    def delete_scsi_controller(self, dbdf):
+        controller_name = 'controller_' + dbdf
+        del_controller_cmd = [self.spdk_rpc_path, 'delete_scsi_controller',
+                              controller_name]
+        _run_cmd_by_root(del_controller_cmd)
+
+    def get_scsi_controller(self, name=None):
+        get_controller_cmd = [self.spdk_rpc_path, 'get_scsi_controller']
+        if name:
+            get_controller_cmd.extend(['-n', name])
+
+        _run_cmd_by_root(get_controller_cmd)
+
+    def add_target(self, bdev_name, dbdf, scsi_tgt_num):
+        LOG.debug('Add target to controller %s with scsi_target_num %s',
+                  dbdf, scsi_tgt_num)
+        controller_name = 'controller_' + dbdf
+        add_tgt_cmd = [
+            self.spdk_rpc_path,
+            'scsi_controller_add_target',
+            controller_name,
+            str(scsi_tgt_num),
+            bdev_name
+        ]
+        _run_cmd_by_root(add_tgt_cmd)
+        LOG.debug('Successfully attach the volume %s to controller %s', bdev_name,
+                  controller_name)
+
+    def remove_target(self, bdev_name, dbdf, scsi_tgt_num):
+        LOG.debug('Remove target to controller %s with scsi_target_num %s',
+                  dbdf, scsi_tgt_num)
+        controller_name = 'controller_' + dbdf
+        remove_tgt_cmd = [
+            self.spdk_rpc_path,
+            'scsi_controller_remove_target',
+            controller_name,
+            str(scsi_tgt_num)
+        ]
+
+        _run_cmd_by_root(remove_tgt_cmd)
+        LOG.debug('Successfully detach the volume %s to controller %s', bdev_name,
+                  controller_name)
+
+    def extract_targets_from_controller(self, controller_info):
+        scsi_targets = {}
+        targets = controller_info['scsi_targets']
+
+        for target in targets:
+            scsi_tgt_num = target['scsi_target_num']
+            bdevs_name = target['bdev_name']
+            scsi_targets[scsi_tgt_num] = bdevs_name
+
+        return scsi_targets
+
+    def parse_controllers_info(self, controllers_info):
+        controllers = {}
+        for info in controllers_info:
+            sessions = info['backend_specific']['session']
+            for controller_info in sessions:
+                # multiple controllers in each session
+                dbdf = controller_info['dbdf']
+                scsi_targets = self.extract_targets_from_controller(controller_info)
+                controllers[dbdf] = scsi_targets
+
+        return controllers
+
+    def scsi_bdev_resize(self, dbdf, scsi_tgt_num, requested_size):
+        # requested_size is in bytes
+        controller_name = 'controller_' + dbdf
+        new_size_in_mb = requested_size // (1024 * 1024)
+        cmd = [self.spdk_rpc_path, 'scsi_bdev_resize', controller_name,
+               str(scsi_tgt_num), str(new_size_in_mb)]
+        _run_cmd_by_root(cmd)
+
+class BLKVolumeDriver(BaseSPDKVolumeDriver):
+    def __init__(self, initiator_iqn, storage_mode='kernel'):
+        super(BLKVolumeDriver, self).__init__(initiator_iqn,
+                                              storage_mode=storage_mode)
+
+    def create_blk_controller(self, function_id, bdev_name, serial):
+        create_controller_cmd = [self.spdk_rpc_path, 'create_blk_controller',
+                                 bdev_name, str(function_id), '-s', serial]
+        _run_cmd_by_root(create_controller_cmd)
+
+    def parse_controllers_info(self, controllers_info):
+        controllers = {}
+        for info in controllers_info:
+            sessions = info['backend_specific']['session']
+            for controller_info in sessions:
+                # 一个session里面可能有多个控制器
+                function_id = controller_info['function_id']
+                bdev = controller_info['block']['bdev']
+                controllers[function_id] = bdev
+
+        return controllers
