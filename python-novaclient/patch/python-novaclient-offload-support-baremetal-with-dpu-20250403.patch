+"""
+Share interface
+"""
+from novaclient import base
+
+
+class Share(base.Resource):
+    """
+    A share is an extra block level storage to the OpenStack
+    instances.
+    """
+    NAME_ATTR = 'display_name'
+
+    def __repr__(self):
+        return "<Share: %s>" % self.id
+
+
+class ShareManager(base.Manager):
+    """
+    Manage :class:`Share` resources. This is really about share attachments.
+    """
+    resource_class = Share
+
+    def create_server_share(self, server_id, share_id):
+        """
+        Attach a share identified by the share ID to the given server ID
+
+        :param server_id: The ID of the server
+        :param share_id: The ID of the share to attach.
+        """
+        if server_id is None:
+            raise TypeError("server_id is required argument.")
+        if share_id is None:
+            raise TypeError("share_id is required argument.")
+
+        body = {
+            'share': {
+                'share_id': share_id
+            }
+        }
+        return self._create("/servers/%s/shares" % server_id, body, "share")
+
+    def delete_server_share(self, server_id, share_id):
+        """
+        Detach a share identified by the share ID from the given server
+
+        :param server_id: The ID of the server
+        :param share_id: The ID of the share to detach
+        :returns: An instance of novaclient.base.TupleWithMeta
+        """
+        if server_id is None:
+            raise TypeError("server_id is required argument.")
+        if share_id is None:
+            raise TypeError("share_id is required argument.")
+
+        return self._delete("/servers/%s/shares/%s" % (server_id, share_id,))
